{
  "name": "mc-heavy",
  "version": "0.1.0",
  "description": "Minecraft 重制版 —— 高性能体素引擎（第一阶段：引擎底座）",
  "type": "module",
  "scripts": {
    "start": "node server-script/start-server.js",
    "icons": "node tools/bake-icon-atlas.mjs",
    "nightsky": "node tools/bake-night-sky.mjs",
    "gianttrees": "node tools/bake-giant-trees.mjs",
    "azaleatrees": "node tools/bake-azalea-trees.mjs",
    "tarn": "node tools/bake-cloudland-kit.mjs",
    "pyramid": "node tools/bake-giant-pyramid.mjs",
    "arena": "node tools/bake-arena.mjs",
    "burningarena": "node tools/bake-burning-arena.mjs",
    "ruinedcitadel": "node tools/bake-ruined-citadel.mjs",
    "gianttextures": "node tools/bake-giant-textures.mjs",
    "leaftextures": "node tools/bake-leaf-textures.mjs",
    "atlas": "node tools/build-atlas.mjs",
    "water": "node tools/bake-water-textures.mjs",
    "test": "node tools/run-unit-node.mjs --all && playwright test",
    "test:unit": "node tools/test-unit-node-runner.mjs && node tools/run-unit-node.mjs",
    "test:unit:all": "node tools/test-unit-node-runner.mjs && node tools/run-unit-node.mjs --all",
    "test:fast": "npm run check && npm run test:unit && playwright test tests/unit-fast.spec.mjs",
    "test:core": "node tools/run-spec-tier.mjs core",
    "test:ui": "node tools/run-spec-tier.mjs ui",
    "test:entity": "node tools/run-spec-tier.mjs entity",
    "test:struct": "node tools/run-spec-tier.mjs struct",
    "test:pixel": "node tools/run-spec-tier.mjs pixel",
    "test:slow": "playwright test tests/harness-slow.spec.mjs",
    "bench": "node src/bench/baseline.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern src tools tests",
    "check:arch": "node tools/check-architecture.mjs",
    "check:data": "node tools/check-data.mjs",
    "check": "npm run check:arch && npm run check:data && npm run lint",
    "validate:weapon-assets": "node tools/validate-weapon-assets.mjs",
    "grasstextures": "node tools/bake-grass-textures.mjs",
    "shallowtarns": "node tools/bake-shallow-tarns.mjs",
    "ship": "node tools/bake-medieval-ship.mjs",
    "zombieskin": "node tools/bake-zombie-skin.mjs",
    "dragon": "node tools/bake-dragon.mjs",
    "ignis": "node tools/bake-ignis.mjs",
    "guardian": "node tools/bake-guardian.mjs",
    "turretop": "node tools/bake-turret-top.mjs",
    "junglefortress": "node tools/bake-jungle-fortress.mjs",
    "stonebricks": "node tools/bake-stone-bricks.mjs",
    "carbineaudio": "node tools/bake-carbine-audio.mjs"
  },
  "author": "jayli",
  "repository": "git@github.com:jayli/mc-heavy.git",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^9.39.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  }
}
